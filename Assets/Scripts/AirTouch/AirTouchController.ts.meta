  InputLines:
    - '// @input string websocketUrl = "ws://127.0.0.1:8765" {"hint":"Mac companion WebSocket URL. Use your Mac IP on device, for example ws://192.168.1.40:8765."}'
    - '// @input string handType = "right" {"hint":"Tracked hand used for AirTouch. Use right or left."}'
    - '// @input float touchThresholdMeters = 0.04 {"hint":"Meters from calibrated plane considered a touch."}'
    - '// @input float touchReleaseThresholdMeters = 0.065 {"hint":"Meters from calibrated plane where touch releases. Keep above touchThresholdMeters to avoid click chatter."}'
    - '// @input float hoverThresholdMeters = 0.12 {"hint":"Meters from calibrated plane considered hover range."}'
    - '// @input float deadzone = 0.002 {"hint":"UV deadzone. Tiny movement below this amount is ignored."}'
    - '// @input float hoverSmoothing = 0.5 {"hint":"UV smoothing while hovering."}'
    - '// @input float dragSmoothing = 0.68 {"hint":"UV smoothing while dragging."}'
    - '// @input float clickSmoothing = 0.9 {"hint":"UV smoothing on the first click frame."}'
    - '// @input float reconnectDelaySeconds = 1.5 {"hint":"Seconds between WebSocket reconnect attempts."}'
    - '// @input bool debugLogging = true {"hint":"Print calibration, projection, and connection status."}'
    - '// @input bool enableEditorSimulator = true {"hint":"In Lens Studio editor, use preview touch/mouse events as fake pointer packets."}'
    - '// @input bool enablePlaneTouchMode = true {"hint":"Use calibrated screen-plane collision as touch down/up, no pinch required after calibration."}'
    - '// @input bool enableScrollGesture {"hint":"Pinch-drag in the hover band sends desktop scroll wheel events. Leave off when testing away-pinch click/drag."}'
    - '// @input bool enableTwoFingerScroll = true {"hint":"Move index and middle fingertips together over the calibrated screen to scroll."}'
    - '// @input bool twoFingerScrollRequiresPlaneTouch = true {"hint":"When plane touch mode is on, require both fingertips to touch the plane for two-finger scroll."}'
    - '// @input float scrollSensitivity = 900 {"hint":"Scroll wheel units produced by one normalized UV unit of pinch-drag movement."}'
    - '// @input float twoFingerScrollSensitivity = 1100 {"hint":"Scroll wheel units produced by one normalized UV unit of two-finger movement."}'
    - '// @input float twoFingerMinSeparationUv = 0.025 {"hint":"Minimum index/middle fingertip separation in UV before two-finger scroll is considered."}'
    - '// @input float twoFingerMaxSeparationUv = 0.22 {"hint":"Maximum index/middle fingertip separation in UV before two-finger scroll is ignored."}'
    - '// @input float twoFingerMaxPlaneDeltaMeters = 0.12 {"hint":"Maximum index/middle distance-to-plane difference in meters for two-finger scroll."}'
    - '// @input float predictionSeconds = 0.05 {"hint":"Seconds of light UV prediction to offset smoothing latency."}'
    - '// @input float maxPredictionUv = 0.025 {"hint":"Maximum predicted UV offset per frame."}'
    - '// @input bool enableFingertipVisuals = true {"hint":"Enable optional fingertip visual feedback objects."}'
    - '// @input float fingertipHoverScale = 0.012 {"hint":"World scale for fingertip visuals while hovering."}'
    - '// @input float fingertipTouchScale = 0.02 {"hint":"World scale for fingertip visuals while touching/clicking."}'
    - '// @input float fingertipScrollScale = 0.016 {"hint":"World scale for fingertip visuals while two-finger scrolling."}'
    - '// @input bool enableCalibrationPlaneVisual = true {"hint":"Show a generated mesh visual for the calibrated screen plane."}'
    - '// @input bool autoCreateCalibrationPlaneVisual = true {"hint":"Create a default plane visual object if one is not assigned."}'
    - '// @input SceneObject calibrationPlaneVisual {"hint":"Optional SceneObject used to render the calibrated screen plane."}'
    - '// @input Asset.Material calibrationPlaneMaterial {"hint":"Optional material used by the generated plane visual."}'
    - '// @input float calibrationPlaneDepthBiasMeters = 0.001 {"hint":"Small normal offset in meters to reduce z-fighting against real geometry."}'
    - '// @input Asset.ObjectPrefab cornerHandlePrefab {"hint":"Prefab used to create the four manual calibration corner handles after the first calibration."}'
    - '// @input float cornerHandleScaleMeters = 0.02 {"hint":"World scale for the calibration corner handles. Increase this if the handles are too hard to grab."}'
